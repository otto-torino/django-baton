{
  "name": "baton",
  "version": "5.2.1",
  "description": "Django Baton App",
  "main": "index.js",
  "scripts": {
    "stats": "npx webpack --config ./webpack.prod.js --json > stats.json",
    "compile": "BATON_REVISION=$(git rev-parse HEAD) npx webpack --config ./webpack.prod.js",
    "watch": "npx webpack --watch --config ./webpack.dev.js",
    "dev:baton": "BATON_REVISION=$(git rev-parse HEAD) webpack serve --host 0.0.0.0 --progress --config ./webpack.dev.js",
    "dev:django": "cd ../../../../testapp/app && ../../.virtualenv/bin/python manage.py runserver",
    "dev": "concurrently \"npm run dev:baton\" \"npm run dev:django\"",
    "lint": "./node_modules/eslint/bin/eslint.js ."
  },
  "author": "abidibo",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "autoprefixer": "^10.2.6",
    "babel-loader": "^8.4.1",
    "bootstrap": "^5.3.1",
    "css-loader": "^5.2.6",
    "diff": "^5.2.2",
    "file-loader": "^6.2.0",
    "ini": "^2.0.0",
    "jquery": "^3.7.1",
    "js-event-dispatcher": "^0.1.0",
    "loader": "^2.1.1",
    "lodash": "^4.18.1",
    "mini-svg-data-uri": "^1.3.3",
    "postcss-loader": "^5.3.0",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.106.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^2.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-dev-server": "^5.2.6"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "concurrently": "^9.1.0",
    "eslint": "^7.27.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-flow-vars": "^0.5.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^5.7.3"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
